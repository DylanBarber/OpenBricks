# Copy this file to .env and choose a unique password (at least 12 characters).
OPENBRICKS_ADMIN_USERNAME=admin
OPENBRICKS_ADMIN_PASSWORD=
OPENBRICKS_PORT=3000
OPENBRICKS_BIND_ADDRESS=0.0.0.0
# Turn on when the remote UI is served through HTTPS.
OPENBRICKS_SECURE_COOKIE=false
SPARK_MASTER=local[2]
SPARK_DRIVER_MEMORY=1g
# Compute and management RAM ceilings; neither container receives extra swap.
OPENBRICKS_MEMORY_LIMIT=4g
OPENBRICKS_CONTROL_MEMORY_LIMIT=1g
# Generate a random token containing at least 32 characters for the private compute API.
OPENBRICKS_COMPUTE_TOKEN=
# Enable the optional services with COMPOSE_PROFILES=storage,catalog.
COMPOSE_PROFILES=
OPENBRICKS_S3_ENDPOINT=
OPENBRICKS_S3_REGION=us-east-1
OPENBRICKS_S3_ACCESS_KEY=
OPENBRICKS_S3_SECRET_KEY=
OPENBRICKS_STORAGE_BIND_ADDRESS=127.0.0.1
OPENBRICKS_STORAGE_PORT=8333
OPENBRICKS_CATALOG_URL=
OPENBRICKS_CATALOG_NAMES=unity
OPENBRICKS_CATALOG_TOKEN=
OPENBRICKS_CATALOG_S3_BUCKETS=openbricks
OPENBRICKS_RUN_TIMEOUT=3600
# Release idle Spark/Python interpreter memory after 15 minutes (0 disables).
# Temporary variables reset after shutdown; saved notebooks and data persist.
OPENBRICKS_IDLE_TIMEOUT_SECONDS=900
OPENBRICKS_MAX_UPLOAD_MB=100
# Optional canonical URL when a reverse proxy changes the incoming Host header.
OPENBRICKS_PUBLIC_URL=
TZ=UTC
# Use the same immutable build identity for management and compute images.
OPENBRICKS_BUILD_ID=development
OPENBRICKS_VERSION=0.3.0-beta.1
# Optional override when deploying compose.compute.yaml on another host.
OPENBRICKS_COMPUTE_IMAGE=ghcr.io/dylanbarber/openbricks-compute:0.3.0-beta.1
OPENBRICKS_RUNTIME_IMAGE=ghcr.io/dylanbarber/openbricks:0.3.0-beta.1
