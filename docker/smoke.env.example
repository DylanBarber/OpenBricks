# Disposable smoke services only. Never use these values for a real deployment.
# The public runner generates unique private values automatically; this template
# documents the Compose inputs and also permits namespace-only cleanup in CI.
OPENBRICKS_SMOKE_RUNTIME_IMAGE=openbricks:smoke
OPENBRICKS_SMOKE_COMPUTE_IMAGE=openbricks-compute:smoke
OPENBRICKS_SMOKE_PASSWORD=DisposableSmokeOnly_ReplaceMe_2026!
OPENBRICKS_SMOKE_COMPUTE_TOKEN=disposable-smoke-compute-replace-me
OPENBRICKS_SMOKE_REMOTE_TOKEN=disposable-smoke-remote-replace-me
OPENBRICKS_SMOKE_RECOVERY_TOKEN=disposable-smoke-recovery-replace-me
OPENBRICKS_SMOKE_S3_ACCESS_KEY=disposable-smoke-storage
OPENBRICKS_SMOKE_S3_SECRET_KEY=disposable-smoke-storage-replace-me
OPENBRICKS_SQLSERVER_PASSWORD=DisposableSqlOnly_ReplaceMe_2026!
OPENBRICKS_RECOVERY_BOOTSTRAP_PASSWORD=DisposableRecoveryOnly_ReplaceMe_2026!
